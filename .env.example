# ============================================================
# CareerOS Environment Configuration
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked CHANGE_ME
# 3. NEVER commit .env to git — it is in .gitignore
#
# Generate secrets with:
#   openssl rand -hex 32
# ============================================================

# ── Environment ──────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── API server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Must change in production — used for cookie signing etc.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
API_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Uvicorn worker count (production)
UVICORN_WORKERS=2

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# These are overridden by docker-compose.yml with the service name
DATABASE_URL=postgresql+asyncpg://careeros:CHANGE_ME_STRONG_PASSWORD@localhost:5432/careeros
DATABASE_URL_SYNC=postgresql://careeros:CHANGE_ME_STRONG_PASSWORD@localhost:5432/careeros

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Frontend ─────────────────────────────────────────────────
# Browser-facing URL of the API.
# In production with nginx on port 80, leave empty or set to your domain.
# The browser will call /api/* which nginx proxies to the api service.
# Example for a VPS: NEXT_PUBLIC_API_URL=https://careeros.example.com
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost

# ── Auth (JWT) ───────────────────────────────────────────────
# Must change — use cryptographically random 32+ byte value
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Storage ──────────────────────────────────────────────────
# local  = files stored in /app/storage (fine for single-server)
# s3     = S3-compatible (required for multi-instance / durable)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# S3-compatible (set STORAGE_BACKEND=s3 for production)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=careeros
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ── Model Router ─────────────────────────────────────────────
# ollama  = local Ollama (default, no API key needed)
# openai  = OpenAI API
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ── Email / SMTP ─────────────────────────────────────────────
EMAIL_ADAPTER=stub
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@careeros.app
SMTP_USE_TLS=true

# IMAP (incoming email processing)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ── Notifications ────────────────────────────────────────────
NOTIFICATION_ADAPTERS=stub
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=careeros-api
PROMETHEUS_PORT=9090

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_JOB_DISCOVERY_PER_HOUR=100
RATE_LIMIT_API_PER_MINUTE=60

# ── Workers ──────────────────────────────────────────────────
WORKER_CONCURRENCY=4
BROWSER_WORKER_CONCURRENCY=2

# Set false to enable real browser automation (Playwright)
# Keep true in development/staging to avoid accidental submissions
BROWSER_TEST_MODE=true

# ── Browser automation (production) ─────────────────────────
BROWSER_MAX_CONCURRENT=2
