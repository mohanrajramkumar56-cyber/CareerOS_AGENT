# ============================================================
# CareerOS Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to source control
# ============================================================

# ---- Environment ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
API_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://careeros:CHANGE_ME_STRONG_PASSWORD@localhost:5432/careeros
DATABASE_URL_SYNC=postgresql://careeros:CHANGE_ME_STRONG_PASSWORD@localhost:5432/careeros

# ---- Redis (queue / cache) ----
REDIS_URL=redis://localhost:6379/0

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Auth ----
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# S3-compatible (set STORAGE_BACKEND=s3 for production)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=careeros
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ---- Model Router ----
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OpenAI-compatible (optional fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ---- Email ----
EMAIL_ADAPTER=stub
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Notifications ----
NOTIFICATION_ADAPTERS=stub
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=careeros-api
PROMETHEUS_PORT=9090

# ---- Rate Limiting ----
RATE_LIMIT_JOB_DISCOVERY_PER_HOUR=100
RATE_LIMIT_API_PER_MINUTE=60

# ---- Workers ----
WORKER_CONCURRENCY=4
BROWSER_WORKER_CONCURRENCY=2
