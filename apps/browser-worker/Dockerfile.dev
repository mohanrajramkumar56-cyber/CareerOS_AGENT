FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libgtk-3-0 \
    libasound2 \
    libxshmfence1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    fonts-liberation \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY apps/browser-worker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt watchfiles

RUN python -m playwright install chromium --with-deps || true

CMD ["python", "-m", "arq", "app.main.BrowserWorkerSettings"]
